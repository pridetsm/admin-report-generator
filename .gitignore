# ── Secrets & environment ─────────────────────────────────────────────
# The deploy/ folder holds the real (sensitive) config that is copied into place
# by hand at deploy time — it must NEVER be committed. See deployment.txt.
/deploy/
webapp/.env
.env
*.env

# Real runtime config that lives at these paths once deployed (samples ARE committed):
/send_report/config.ini
/prometheus.yml
/deployments/standalone/systems admin report/config.ini

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Django ────────────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
/webapp/staticfiles/
*.log

# ── OS / editor / misc dev artefacts ──────────────────────────────────
.DS_Store
Thumbs.db
*.xlsx
*.png
!webapp/static/img/logo.png
!send_report/logo.png
!deployments/standalone/systems admin report/logo.png
# The header mark is a SHIPPED asset, not a screenshot: without it the deployed app has no
# manifest entry for it and the header breaks. Same for the design references it came from.
!webapp/static/img/brand-mark.png
!webapp/design-assets/*.png
# Platform glyphs for the system pickers. SHIPPED assets for the same reason as the header
# mark: app.css masks them by url(), so collectstatic fails outright if they aren't committed.
!webapp/static/img/os/*.png
# Role glyphs for the Role Select tiles. SHIPPED assets: the picker renders them by <img>,
# so without them every tile on the first screen after sign-in is a broken image.
!webapp/static/img/roles/*.png
Screenshot*.png
example.png
.claude/
.idea/
.vscode/
