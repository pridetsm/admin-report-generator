# =============================================================================
#  @@FILENAME@@ - schedule for @@SH_NAME@@ (@@SYSTEM@@).
#
#  GENERATED by the RBZ Monitoring Console (Configuration > Scripts) on @@GENERATED_AT@@.
#  Change the schedule in the console and regenerate rather than editing here — a regenerate
#  overwrites this file, and an edit made here is invisible to the console.
#
#  Install:  sudo cp @@SH_NAME@@ /usr/local/bin/ && sudo chmod +x /usr/local/bin/@@SH_NAME@@
#            sudo cp @@FILENAME@@ /etc/cron.d/@@CRON_NAME@@
#            sudo chmod 644 /etc/cron.d/@@CRON_NAME@@
#
#  Runs as root so it can read the backup root and write the node_exporter textfile
#  directory. Output goes to the log rather than to mail: a cron job that mails on every
#  run trains people to ignore it, and this one runs daily.
#
#  Schedule it AFTER the backup window — running before it reports the previous day's
#  file, which is correct but a day behind, and looks like a failure the morning someone
#  actually checks.
# =============================================================================
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

@@CRON_SCHEDULE@@ root /usr/local/bin/@@SH_NAME@@ >> /var/log/@@LOG_NAME@@ 2>&1
